{
  "name": "musedock",
  "version": "1.0.0",
  "description": "抖音/小红书内容抓取工具 - Web GUI",
  "main": "server/index.js",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22 <23"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renmengwen/MuseDock.git"
  },
  "bugs": {
    "url": "https://github.com/renmengwen/MuseDock/issues"
  },
  "homepage": "https://github.com/renmengwen/MuseDock#readme",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node start-server.js",
    "dev:frontend": "vite --config frontend-react/vite.config.js",
    "build:frontend": "vite build --config frontend-react/vite.config.js",
    "test": "node tests/run-all.js",
    "test:filter": "node tests/run-all.js",
    "test:ai-text": "node tests/test-ai-text-model.js",
    "test:agent": "node tests/test-ai-text-model.js && node tests/test-agent-runs.js",
    "test:agent-utils": "node tests/test-agent-run-utils.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@vitejs/plugin-react": "^6.0.2",
    "better-sqlite3": "^11.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.17.0",
    "playwright": "^1.51.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "tailwind-merge": "^2.6.0",
    "vite": "^8.0.16",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19"
  }
}
