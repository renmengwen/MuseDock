{
  "name": "musedock",
  "version": "1.0.0",
  "description": "抖音/小红书内容抓取工具 - Web GUI",
  "main": "electron/main.js",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22 <23"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renmengwen/MuseDock.git"
  },
  "bugs": {
    "url": "https://github.com/renmengwen/MuseDock/issues"
  },
  "homepage": "https://github.com/renmengwen/MuseDock#readme",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node start-server.js",
    "dev:frontend": "vite --config frontend-react/vite.config.js",
    "build:frontend": "vite build --config frontend-react/vite.config.js",
    "electron": "electron .",
    "dist": "npm run build:frontend && electron-builder --win",
    "postdist": "npm rebuild better-sqlite3",
    "test": "node tests/run-all.js",
    "test:filter": "node tests/run-all.js",
    "test:ai-text": "node tests/test-ai-text-model.js"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "playwright-core": "^1.51.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^42.6.0",
    "electron-builder": "^26.15.3",
    "gsap": "^3.15.0",
    "lucide-react": "^1.17.0",
    "postcss": "^8.5.15",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.16"
  },
  "build": {
    "appId": "com.musedock.app",
    "productName": "MuseDock",
    "asar": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "!server/**/*.backup",
      "frontend-dist/**/*",
      "docs/frame/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
